# ==============================================================================
# ZARA AI 2070 — environment configuration example
# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in YOUR OWN values. NEVER commit `.env`.
# The app launches without any keys and shows "AI SERVICE NOT CONFIGURED" until
# you provide one. Add your key, restart the app, and ZARA becomes operational —
# no rebuild required.
# ==============================================================================

# ---- Core AI provider (primary key for chat) -------------------------------
# The generic placeholder used by the app's secure config layer.
# Fill in the API key for the provider you choose below (OpenAI, OpenRouter,
# DeepSeek, Z.ai, MiniMax, Codex, Ollama, LM Studio) and select it in Settings.
AI_API_KEY=YOUR_API_KEY_HERE
AI_MODEL=YOUR_MODEL_HERE

# ---- OpenAI ----------------------------------------------------------------
VITE_OPENAI_API_KEY=''
# Supports chat, image generation, TTS, STT, embeddings.

# ---- OpenRouter (alternative) ---------------------------------------------
VITE_OPENROUTER_API_KEY=''

# ---- DeepSeek (alternative) ------------------------------------------------
VITE_DEEPSEEK_API_KEY=''

# ---- Z.ai / MiniMax (alternatives) ----------------------------------------
VITE_ZAI_API_KEY=''
VITE_MINIMAX_API_KEY=''

# ---- Groq whisper API Key (STT, optional) ----------------------------------
VITE_GROQ_API_KEY=''

# ---- Local inference (no key required) -------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# LM_STUDIO_BASE_URL=http://localhost:1234

# ---- Function calling sources (optional) -----------------------------------
VITE_JACKETT_API_KEY=''
VITE_JACKETT_URL=''
VITE_QB_URL=''
VITE_QB_USERNAME=''
VITE_QB_PASSWORD=''

# ---- Web search (optional) -------------------------------------------------
# VITE_SEARXNG_URL=http://localhost:8080

# ---- Browser / computer-control bridges (optional, for advanced control) ---
# ZARA_BROWSER_BRIDGE_URL=
# ZARA_DESKTOP_BRIDGE_URL=
