// @see https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'zaraaiapp',
  asar: true,
  productName: 'Zara AI',
  directories: {
    output: 'release/${version}',
  },
  publish: [
    {
      provider: 'github',
      owner: 'muhammadlai',
      repo: 'P9rsOn_Oi',
      releaseType: 'release',
    },
  ],
  files: ['dist', 'dist-electron'],
  extraResources: [
    {
      from: './app-config.json',
      to: 'app-config.json',
    },
    {
      from: 'resources/backend',
      to: 'backend',
      filter: ['**/*'],
    },
    {
      from: 'backend/lib',
      to: 'backend/lib',
      filter: ['**/*'],
    },
    {
      from: 'backend/models',
      to: 'backend/models',
      filter: ['**/*'],
    },
  ],
  mac: {
    target: ['dmg'],
    icon: 'public/app_logo.png',
    entitlements: 'build/entitlements.mac.plist',
    entitlementsInherit: 'build/entitlements.mac.plist',
    extendInfo: {
      NSMicrophoneUsageDescription:
        'Zara uses the microphone for voice activity detection and speech recognition.',
    },
    artifactName: 'Zara-AI-App-Mac-${version}-Installer.${ext}',
  },
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    artifactName: 'Zara-AI-App-Windows-${version}-Setup.${ext}',
  },
  nsis: {
    oneClick: true,
    perMachine: false,
    allowToChangeInstallationDirectory: false,
    deleteAppDataOnUninstall: false,
  },
  compression: 'store',
  linux: {
    target: ['AppImage'],
    category: 'Utility',
    icon: 'public/app_logo.png',
    artifactName: 'Zara-AI-App-Linux-${version}.${ext}',
  },
}
