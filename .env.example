# =====================================================================
# ZARA AI — Environment Configuration Example
# =====================================================================
# Copy this file to `.env` and replace the placeholders with your own
# credentials. `.env` is git-ignored and is NEVER committed.
#
#     cp .env.example .env
#
# These variables are read by the ELECTRON MAIN PROCESS ONLY.
# They are never inlined into the renderer/frontend bundle, and the raw
# key is never sent to the UI — the UI only receives a masked preview
# and a connection status.
#
# Leaving every value as a placeholder is fine: ZARA still launches and
# reports "AI STATUS: NOT CONFIGURED" instead of crashing.
# =====================================================================

# ---------------------------------------------------------------------
# AI brain (primary)
# ---------------------------------------------------------------------
AI_API_KEY=YOUR_API_KEY_HERE
AI_MODEL=YOUR_MODEL_HERE

# Which provider the key above belongs to.
# Supported: openai | openrouter | deepseek | zai | minimax | ollama | lm-studio
AI_PROVIDER=openai

# Optional: override the provider endpoint (for self-hosted / proxy setups).
# Leave empty to use the provider default.
AI_BASE_URL=

# ---------------------------------------------------------------------
# Speech-to-text (optional — local Whisper is used when unset)
# ---------------------------------------------------------------------
STT_API_KEY=YOUR_API_KEY_HERE
STT_PROVIDER=local

# ---------------------------------------------------------------------
# Text-to-speech (optional — local Piper is used when unset)
# ---------------------------------------------------------------------
TTS_API_KEY=YOUR_API_KEY_HERE
TTS_PROVIDER=local

# ---------------------------------------------------------------------
# Browser bridge (ZARA <-> browser extension)
# ---------------------------------------------------------------------
# Port the local browser-control bridge listens on (127.0.0.1 only).
ZARA_BRIDGE_PORT=5421

# ---------------------------------------------------------------------
# Optional integrations — leave as placeholders if unused
# ---------------------------------------------------------------------
WEB_SEARCH_API_KEY=YOUR_API_KEY_HERE
SEARXNG_URL=
