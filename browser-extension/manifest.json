{
  "manifest_version": 3,
  "name": "ZARA Browser Bridge",
  "version": "1.0.0",
  "description": "Lets ZARA read page context and control tabs (back, forward, refresh, new tab, close tab) in your real browser.",
  "permissions": ["tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ZARA Browser Bridge",
    "default_popup": "popup.html"
  }
}
